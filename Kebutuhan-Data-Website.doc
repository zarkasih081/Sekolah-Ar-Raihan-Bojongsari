  body { font-family: 'Calibri', 'Arial', sans-serif; font-size: 11pt; line-height: 1.5; color: #000000; }
  h1 { font-size: 16pt; color: #05294A; border-bottom: 2px solid #FFC800; padding-bottom: 5px; }
  h2 { font-size: 13pt; color: #0A4D8C; margin-top: 20px; }
